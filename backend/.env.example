GDB_DB_URL=jdbc:postgresql://127.0.0.1:5432/gdb
GDB_DB_USERNAME=gdb_app
GDB_DB_PASSWORD=replace-with-secret
GDB_ADMIN_TOKEN=replace-with-at-least-32-random-characters
GDB_SNAPSHOT_MASTER_KEY=replace-with-base64-encoded-32-byte-key
GDB_SNAPSHOT_STORAGE=/var/lib/gdb/snapshots
GDB_SERVER_ADDRESS=127.0.0.1
GDB_SERVER_PORT=8095
GDB_ALLOWED_ORIGINS=https://gdb-admin.private.example
