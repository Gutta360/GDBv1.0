# Review privately before use. This example does not change any existing Nginx
# configuration. Tailscale terminates HTTPS and forwards the approved admin
# Service to this loopback gateway. A separate sync Service should use the
# restricted second gateway below.
server {
    listen 127.0.0.1:8093;
    server_name gdb-admin-internal;
    root /home/gutta/gdb/frontend/current/browser;
    index index.html;

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8092;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 60m;
    }

    location = /actuator/health {
        proxy_pass http://127.0.0.1:8092;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

# Device synchronization ingress. Expose this gateway only through the
# separately ACL-protected Tailscale Service; it has no Angular or admin route.
server {
    listen 127.0.0.1:8094;
    server_name gdb-sync-internal;

    location = /api/v1/devices/register { proxy_pass http://127.0.0.1:8092; client_max_body_size 1m; }
    location /api/v1/sync/ { proxy_pass http://127.0.0.1:8092; client_max_body_size 5m; }
    location = /api/v1/snapshots { proxy_pass http://127.0.0.1:8092; client_max_body_size 60m; }
    location /api/v1/snapshots/ { proxy_pass http://127.0.0.1:8092; client_max_body_size 60m; }
    location / { return 404; }
}
