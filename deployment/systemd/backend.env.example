GDB_DB_URL=jdbc:postgresql://127.0.0.1:5433/gdb
GDB_DB_USERNAME=gdb_app
GDB_DB_PASSWORD=replace-me
GDB_DB_POOL_MAX=10
GDB_DB_POOL_MIN=2
GDB_DB_CONNECTION_TIMEOUT_MS=5000
# Initial provisioning/emergency recovery only; rotate and disable the
# bootstrap endpoint after the first administrator is created.
GDB_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
GDB_ADMIN_SESSION_TTL=PT8H
GDB_ADMIN_SESSION_COOKIE_SECURE=true
GDB_SNAPSHOT_MASTER_KEY=replace-me
GDB_SNAPSHOT_STORAGE=/var/lib/gdb/snapshots
GDB_SERVER_ADDRESS=127.0.0.1
GDB_SERVER_PORT=8092
GDB_ALLOWED_ORIGINS=https://gdb-admin.<approved-tailnet-service-name>
